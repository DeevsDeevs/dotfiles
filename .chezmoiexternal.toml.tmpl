{{ if eq .chezmoi.os "darwin" -}}
# https, not SSH: `chezmoi init` on a machine whose GitHub key isn't loaded yet
# cannot clone over SSH, and the clone failing means ~/.config/sketchybar never
# appears at all. The repo is public, so https needs no credentials. To push
# from the checkout, switch its remote afterwards:
#   git -C ~/.config/sketchybar remote set-url origin git@github.com:DeevsDeevs/deevs-sketchybar.git
[".config/sketchybar"]
    type = "git-repo"
    url = "https://github.com/DeevsDeevs/deevs-sketchybar.git"
    refreshPeriod = "168h"

# My Herdr mods, each out of its item folder in deevs-herdr-kit (<name>/mods/<name>/);
# the item's README, recipe and preview stay out. Add a mod by adding its name.
# Not exact: Herdr writes jsconfig.json and gpui-kit.d.ts into every mod folder.
{{ range list "agent-browser" "agent-images" -}}
[".config/herdr-app/mods/{{ . }}"]
    type = "archive"
    url = "https://github.com/DeevsDeevs/deevs-herdr-kit/archive/refs/heads/main.tar.gz"
    stripComponents = 4
    include = ["*/{{ . }}/mods/{{ . }}/**"]
    refreshPeriod = "24h"
{{ end -}}
{{ end -}}
